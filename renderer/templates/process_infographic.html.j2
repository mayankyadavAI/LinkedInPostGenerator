<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700;0,9..40,900;1,9..40,500&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { width: 1080px; overflow: hidden; }

  :root {
    --paper:    #f8f7f4;
    --surface:  #ffffff;
    --surface2: #f2f0ec;
    --ink:      #111318;
    --ink2:     #4a4f5c;
    --ink3:     #9098a9;
    --blue:     #2563eb;
    --violet:   #7c3aed;
    --teal:     #0d9488;
    --amber:    #d97706;
    --rose:     #db2777;
    --border:   #e4e2dc;
    --mockbg:   #111827;
  }

  /* ── page shell ── */
  .page {
    width: 1080px; height: 1410px;
    background: var(--paper);
    position: relative; overflow: hidden;
    font-family: 'Inter', sans-serif;
  }

  /* subtle dot-grid background */
  .page::before {
    content: '';
    position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(0,0,0,0.07) 1px, transparent 1px);
    background-size: 32px 32px;
    pointer-events: none; z-index: 0;
  }

  /* top accent bar — thick bold editorial stripe */
  .accent-bar {
    position: absolute; top: 0; left: 0; right: 0; height: 6px; z-index: 2;
    background: linear-gradient(90deg, var(--blue) 0%, var(--violet) 45%, var(--teal) 100%);
  }

  .content {
    position: absolute; left: 60px; top: 0; right: 60px; bottom: 0; z-index: 1;
  }

  /* ── header row ── */
  .header-row {
    position: absolute; top: 36px; left: 0; right: 0;
    display: flex; align-items: center; justify-content: space-between;
  }
  .eyebrow {
    display: inline-flex; align-items: center; gap: 9px;
    background: var(--surface);
    border: 2px solid var(--blue);
    border-radius: 8px; padding: 8px 18px 8px 14px;
    box-shadow: 3px 3px 0 rgba(37,99,235,0.12);
  }
  .eyebrow-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--blue);
  }
  .eyebrow span {
    font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 12px;
    color: var(--blue); letter-spacing: 1.4px; text-transform: uppercase;
  }
  .corner-tag {
    font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 13px;
    color: var(--surface); background: var(--ink);
    border-radius: 6px; padding: 7px 14px;
    letter-spacing: 0.3px;
  }

  /* ── title block ── */
  .title-block { position: absolute; left: 0; top: 88px; width: 860px; }
  .h-line {
    font-family: 'DM Sans', 'Inter', sans-serif; font-weight: 900;
    font-size: 64px; line-height: 1.06; letter-spacing: -1.5px;
  }
  .h-line.l1 { color: var(--ink); }
  .h-line.l2 {
    color: transparent;
    background: linear-gradient(90deg, var(--blue) 0%, var(--violet) 60%, var(--teal) 100%);
    -webkit-background-clip: text; background-clip: text;
  }
  .tagline-row {
    display: flex; align-items: center; gap: 12px; margin-top: 14px;
  }
  .tagline-bar {
    width: 3px; height: 22px; border-radius: 2px;
    background: linear-gradient(180deg, var(--blue), var(--violet));
    flex-shrink: 0;
  }
  .tagline {
    font-family: 'Inter', sans-serif; font-weight: 600; font-size: 19px;
    color: var(--ink2);
  }

  /* divider */
  .divider {
    position: absolute; left: 0; width: 960px; height: 2px;
    background: linear-gradient(90deg, var(--blue) 0%, var(--violet) 50%, transparent 100%);
    opacity: 0.2;
  }

  /* ── section label ── */
  .section-label {
    position: absolute; left: 0;
    display: flex; align-items: center; gap: 10px;
  }
  .sl-bar { width: 3px; height: 18px; background: var(--blue); border-radius: 2px; }
  .sl-text {
    font-family: 'Inter', sans-serif; font-weight: 800; font-size: 11px;
    color: var(--blue); letter-spacing: 2.5px; text-transform: uppercase;
  }

  /* ── stage mockups ── */
  .stage { position: absolute; }
  .stage-label-row {
    display: flex; align-items: center; gap: 7px; margin-bottom: 10px;
  }
  .stage-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--c);
  }
  .stage-label {
    font-family: 'Inter', sans-serif; font-weight: 700; font-size: 12px;
    letter-spacing: 1.8px; text-transform: uppercase; color: var(--c);
  }

  .mockwin {
    width: 100%; height: 158px;
    background: var(--mockbg); border-radius: 12px;
    padding: 14px 16px;
    border-top: 3px solid var(--c);
    box-shadow: 4px 6px 0 rgba(0,0,0,0.15), 0 2px 12px rgba(0,0,0,0.1);
  }
  .mockwin .dots { display: flex; gap: 5px; margin-bottom: 12px; }
  .mockwin .dot { width: 9px; height: 9px; border-radius: 50%; }
  .mockwin .dot.r { background: #ff5f56; }
  .mockwin .dot.y { background: #ffbd2e; }
  .mockwin .dot.g { background: #27c93f; }
  .mockwin .snippet {
    font-family: 'JetBrains Mono', monospace; font-weight: 500;
    font-size: 16px; line-height: 1.65;
  }
  .mockwin.chip {
    display: flex; align-items: center; justify-content: center; flex-direction: column;
  }
  .mockwin.chip svg { width: 52px; height: 52px; }
  .mockwin.chip .snippet { margin-top: 10px; font-size: 13px; text-align: center; }

  /* stage color bindings */
  .stage0 .mockwin { --c: var(--blue); }
  .stage0 .stage-dot { --c: var(--blue); }
  .stage0 .stage-label { --c: var(--blue); }
  .stage0 .snippet { color: #60a5fa; }

  .stage1 .mockwin { --c: var(--violet); }
  .stage1 .stage-dot { --c: var(--violet); }
  .stage1 .stage-label { --c: var(--violet); }
  .stage1 .snippet { color: #c4b5fd; }

  .stage2 .mockwin { --c: var(--teal); }
  .stage2 .stage-dot { --c: var(--teal); }
  .stage2 .stage-label { --c: var(--teal); }
  .stage2 .snippet { color: #5eead4; }

  /* ── step cards ── */
  .card {
    position: absolute;
    background: var(--surface); border-radius: 14px;
    border: 2px solid var(--border);
    border-left: 4px solid var(--c);
    padding: 20px 22px 18px 26px;
    box-shadow: 4px 5px 0 rgba(0,0,0,0.06), 0 2px 12px rgba(0,0,0,0.05);
  }
  .card.c1 { --c: var(--blue); }
  .card.c2 { --c: var(--violet); }
  .card.c3 { --c: var(--teal); }
  .card.c4 { --c: var(--amber); }

  .card-header { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
  .card-num {
    width: 32px; height: 32px; border-radius: 8px;
    background: var(--c); color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-family: 'JetBrains Mono', monospace; font-weight: 700;
    font-size: 14px; flex-shrink: 0;
  }
  .card-title {
    font-family: 'DM Sans', 'Inter', sans-serif; font-weight: 700; font-size: 21px;
    color: var(--ink); letter-spacing: -0.2px;
  }
  .card-pts { list-style: none; }
  .card-pts li {
    font-family: 'Inter', sans-serif; font-weight: 500; font-size: 16px;
    color: var(--ink2); line-height: 1.6;
    padding-left: 20px; position: relative; margin-bottom: 4px;
  }
  .card-pts li::before {
    content: "–"; position: absolute; left: 0;
    color: var(--c); font-weight: 700;
  }

  /* ── flow strips ── */
  .flow-block { position: absolute; left: 0; width: 660px; }
  .flow-label {
    font-family: 'Inter', sans-serif; font-weight: 700; font-size: 10px;
    color: var(--blue); letter-spacing: 2.5px; text-transform: uppercase;
    margin-bottom: 10px;
  }
  .flow-row { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; }
  .flow-chip {
    font-family: 'Inter', sans-serif; font-weight: 600; font-size: 12px;
    color: var(--ink);
    border: 2px solid var(--border);
    border-radius: 6px; background: var(--surface);
    padding: 6px 12px; white-space: nowrap;
    box-shadow: 2px 2px 0 rgba(0,0,0,0.06);
  }
  .flow-chevron {
    display: flex; align-items: center; color: var(--ink3);
  }
  .flow-chevron svg { width: 14px; height: 14px; overflow: visible; }

  /* ── insight callout ── */
  .callout {
    position: absolute; right: 0; width: 248px;
    background: var(--surface);
    border: 2px solid var(--border);
    border-radius: 12px;
    padding: 22px 18px 18px 22px;
    box-shadow: 4px 5px 0 rgba(0,0,0,0.07);
    overflow: hidden;
  }
  .callout::before {
    content: '';
    position: absolute; top: 0; left: 0; bottom: 0; width: 4px;
    background: linear-gradient(180deg, var(--blue), var(--violet), var(--teal));
    border-radius: 12px 0 0 12px;
  }
  .callout::after {
    content: '\201C';
    position: absolute; top: -8px; right: 12px;
    font-family: 'DM Sans', serif; font-size: 80px; font-weight: 900;
    color: rgba(37,99,235,0.06); line-height: 1;
    pointer-events: none;
  }
  .callout-label {
    font-family: 'Inter', sans-serif; font-weight: 700; font-size: 10px;
    color: var(--violet); letter-spacing: 2px; text-transform: uppercase;
    margin-bottom: 10px; display: flex; align-items: center; gap: 6px;
  }
  .callout-label-dot {
    width: 5px; height: 5px; border-radius: 50%;
    background: var(--violet);
  }
  .callout-text {
    font-family: 'DM Sans', 'Inter', sans-serif; font-style: italic;
    font-weight: 500; font-size: 16px;
    color: var(--ink); line-height: 1.55;
    position: relative; z-index: 1;
  }

  /* ── footer ── */
  .footer {
    position: absolute; left: 0; width: 960px;
    display: flex; align-items: center; justify-content: space-between;
    padding-top: 14px;
    border-top: 2px solid var(--border);
  }
  .footer-handle {
    font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 13px;
    color: var(--blue);
  }
  .footer-tag {
    font-family: 'Inter', sans-serif; font-weight: 500; font-size: 12px;
    color: var(--ink3);
  }
  .footer-badge {
    font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 11px;
    color: var(--ink2);
    border: 2px solid var(--border);
    border-radius: 4px; padding: 3px 8px;
    letter-spacing: 0.5px;
  }
</style>
</head>
<body>
<div class="page">
  <div class="accent-bar"></div>
  <div class="content">

    <div class="header-row">
      <div class="eyebrow">
        <div class="eyebrow-dot"></div>
        <span>AI Systems · How It Works</span>
      </div>
      <div class="corner-tag">&lt;/&gt; eng notes</div>
    </div>

    <div class="title-block">
      <div id="h1" class="h-line l1">{{ title_line1 }}</div>
      <div id="h2" class="h-line l2">{{ title_line2 }}</div>
      <div class="tagline-row">
        <div class="tagline-bar"></div>
        <div class="tagline">{{ tagline }}</div>
      </div>
    </div>

    <div class="divider" id="hr1"></div>

    <div class="section-label" id="sectionRule">
      <div class="sl-bar"></div>
      <div class="sl-text">{{ section_label }}</div>
    </div>

    <!-- Stage row -->
    <div class="stage stage0" id="stage0" style="left:0px;width:290px">
      <div class="stage-label-row">
        <div class="stage-dot"></div>
        <div class="stage-label">{{ stages[0].label }}</div>
      </div>
      <div class="mockwin">
        <div class="dots"><div class="dot r"></div><div class="dot y"></div><div class="dot g"></div></div>
        <div class="snippet">{{ stages[0].snippet }}</div>
      </div>
    </div>

    <div class="stage stage1" id="stage1" style="left:335px;width:290px">
      <div class="stage-label-row">
        <div class="stage-dot"></div>
        <div class="stage-label">{{ stages[1].label }}</div>
      </div>
      <div class="mockwin chip">
        <svg viewBox="0 0 30 30" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="color:#c4b5fd">
          <rect x="8" y="8" width="14" height="14" rx="2"/>
          <line x1="12" y1="2" x2="12" y2="8"/><line x1="18" y1="2" x2="18" y2="8"/>
          <line x1="12" y1="22" x2="12" y2="28"/><line x1="18" y1="22" x2="18" y2="28"/>
          <line x1="2" y1="12" x2="8" y2="12"/><line x1="2" y1="18" x2="8" y2="18"/>
          <line x1="22" y1="12" x2="28" y2="12"/><line x1="22" y1="18" x2="28" y2="18"/>
        </svg>
        <div class="snippet">{{ stages[1].snippet }}</div>
      </div>
    </div>

    <div class="stage stage2" id="stage2" style="left:670px;width:290px">
      <div class="stage-label-row">
        <div class="stage-dot"></div>
        <div class="stage-label">{{ stages[2].label }}</div>
      </div>
      <div class="mockwin">
        <div class="dots"><div class="dot r"></div><div class="dot y"></div><div class="dot g"></div></div>
        <div class="snippet">{{ stages[2].snippet }}</div>
      </div>
    </div>

    <!-- Gradient flow arrows between stages -->
    <svg id="stage-arrows" style="position:absolute;left:0;top:0;pointer-events:none;overflow:visible"
         width="960" height="800">
      <defs>
        <linearGradient id="arr-grad-01" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#2563eb" stop-opacity="0.2"/>
          <stop offset="60%" stop-color="#2563eb" stop-opacity="0.7"/>
          <stop offset="100%" stop-color="#7c3aed" stop-opacity="0.9"/>
        </linearGradient>
        <linearGradient id="arr-grad-12" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#7c3aed" stop-opacity="0.2"/>
          <stop offset="60%" stop-color="#7c3aed" stop-opacity="0.7"/>
          <stop offset="100%" stop-color="#0d9488" stop-opacity="0.9"/>
        </linearGradient>
        <marker id="arrowhead-01" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
          <polygon points="0 0.5, 9.5 3.5, 0 6.5" fill="#7c3aed" opacity="0.9"/>
        </marker>
        <marker id="arrowhead-12" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
          <polygon points="0 0.5, 9.5 3.5, 0 6.5" fill="#0d9488" opacity="0.9"/>
        </marker>
      </defs>
    </svg>

    <!-- 4 step cards 2×2 -->
    <div class="card c1" id="card0" style="left:0px;width:460px">
      <div class="card-header"><div class="card-num">01</div><div class="card-title">{{ steps[0].label }}</div></div>
      <ul class="card-pts">{% for p in steps[0].points %}<li>{{ p }}</li>{% endfor %}</ul>
    </div>
    <div class="card c2" id="card1" style="left:500px;width:460px">
      <div class="card-header"><div class="card-num">02</div><div class="card-title">{{ steps[1].label }}</div></div>
      <ul class="card-pts">{% for p in steps[1].points %}<li>{{ p }}</li>{% endfor %}</ul>
    </div>
    <div class="card c3" id="card2" style="left:0px;width:460px">
      <div class="card-header"><div class="card-num">03</div><div class="card-title">{{ steps[2].label }}</div></div>
      <ul class="card-pts">{% for p in steps[2].points %}<li>{{ p }}</li>{% endfor %}</ul>
    </div>
    <div class="card c4" id="card3" style="left:500px;width:460px">
      <div class="card-header"><div class="card-num">04</div><div class="card-title">{{ steps[3].label }}</div></div>
      <ul class="card-pts">{% for p in steps[3].points %}<li>{{ p }}</li>{% endfor %}</ul>
    </div>

    <!-- Flow strips + callout -->
    <div class="flow-block" id="flowA">
      <div class="flow-label">pipeline</div>
      <div class="flow-row">
        {% for item in flow_a_items %}
        <div class="flow-chip">{{ item }}</div>
        {% if not loop.last %}
        <span class="flow-chevron">
          <svg viewBox="0 0 14 14" fill="none">
            <defs>
              <linearGradient id="chev-la-{{ loop.index }}" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#2563eb" stop-opacity="0.3"/>
                <stop offset="100%" stop-color="#7c3aed" stop-opacity="0.9"/>
              </linearGradient>
            </defs>
            <polyline points="3,2 9,7 3,12" stroke="url(#chev-la-{{ loop.index }})" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
        </span>
        {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="flow-block" id="flowB">
      <div class="flow-label">summary</div>
      <div class="flow-row">
        {% for item in flow_b_items %}
        <div class="flow-chip">{{ item }}</div>
        {% if not loop.last %}
        <span class="flow-chevron">
          <svg viewBox="0 0 14 14" fill="none">
            <defs>
              <linearGradient id="chev-lb-{{ loop.index }}" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#7c3aed" stop-opacity="0.3"/>
                <stop offset="100%" stop-color="#0d9488" stop-opacity="0.9"/>
              </linearGradient>
            </defs>
            <polyline points="3,2 9,7 3,12" stroke="url(#chev-lb-{{ loop.index }})" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
        </span>
        {% endif %}
        {% endfor %}
      </div>
    </div>

    <!-- Pull-quote callout -->
    <div class="callout" id="callout">
      <div class="callout-label">
        <div class="callout-label-dot"></div>
        key insight
      </div>
      <div class="callout-text">{{ hook }}</div>
    </div>

    <!-- Footer -->
    <div class="footer" id="footer">
      <div class="footer-handle">{{ infographic_handle if infographic_handle else "@AISystemsNotes" }}</div>
      <div class="footer-tag">daily notes on the systems behind AI</div>
      <div class="footer-badge">AI/ML</div>
    </div>

  </div>
</div>

<script>
window._infoDone = false;

window.drawInfographic = function() {
  if (window._infoDone) return;
  window._infoDone = true;

  var content = document.querySelector('.content');
  var cr = content.getBoundingClientRect();

  // Shrink oversized title lines
  ['h1','h2'].forEach(function(id) {
    var el = document.getElementById(id);
    if (!el) return;
    var sz = parseFloat(getComputedStyle(el).fontSize);
    while (el.scrollWidth > 840 && sz > 28) { sz -= 2; el.style.fontSize = sz + 'px'; }
  });

  // Shrink card titles
  document.querySelectorAll('.card-title').forEach(function(el) {
    var sz = parseFloat(getComputedStyle(el).fontSize);
    while (el.scrollWidth > 390 && sz > 15) { sz--; el.style.fontSize = sz + 'px'; }
  });

  // Shrink snippets
  document.querySelectorAll('.mockwin .snippet').forEach(function(el) {
    var sz = parseFloat(getComputedStyle(el).fontSize);
    while (el.scrollWidth > 258 && sz > 11) { sz--; el.style.fontSize = sz + 'px'; }
  });

  // Position divider and section label
  var titleBlock = document.querySelector('.title-block');
  var titleBottom = titleBlock.getBoundingClientRect().bottom - cr.top;

  var hr1 = document.getElementById('hr1');
  hr1.style.top = (titleBottom + 22) + 'px';

  var sectionRule = document.getElementById('sectionRule');
  var ruleTop = titleBottom + 22 + 26;
  sectionRule.style.top = ruleTop + 'px';
  var ruleH = sectionRule.getBoundingClientRect().height;

  // Position stages
  var stageTop = ruleTop + ruleH + 22;
  ['stage0', 'stage1', 'stage2'].forEach(function(id) {
    document.getElementById(id).style.top = stageTop + 'px';
  });

  // Gradient arrows
  function stageRect(id) {
    var el = document.querySelector('#' + id + ' .mockwin');
    var r = el.getBoundingClientRect();
    return { L: r.left - cr.left, R: r.right - cr.left, cy: (r.top + r.bottom) / 2 - cr.top };
  }
  var s0 = stageRect('stage0'), s1 = stageRect('stage1'), s2 = stageRect('stage2');
  var svg = document.getElementById('stage-arrows');

  function addGradientArrow(x1, y1, x2, y2, gradId, headId) {
    var line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    line.setAttribute('x1', x1 + 4); line.setAttribute('y1', y1);
    line.setAttribute('x2', x2 - 10); line.setAttribute('y2', y2);
    line.setAttribute('stroke', 'url(#' + gradId + ')');
    line.setAttribute('stroke-width', '2.5');
    line.setAttribute('stroke-linecap', 'round');
    line.setAttribute('marker-end', 'url(#' + headId + ')');
    svg.appendChild(line);
  }
  addGradientArrow(s0.R, s0.cy, s1.L, s1.cy, 'arr-grad-01', 'arrowhead-01');
  addGradientArrow(s1.R, s1.cy, s2.L, s2.cy, 'arr-grad-12', 'arrowhead-12');

  // 2×2 card grid
  function mockBottom(id) {
    var el = document.querySelector('#' + id + ' .mockwin');
    return el.getBoundingClientRect().bottom - cr.top;
  }
  var maxStageBottom = Math.max(mockBottom('stage0'), mockBottom('stage1'), mockBottom('stage2'));
  var row1Top = maxStageBottom + 44;

  var c0 = document.getElementById('card0'), c1 = document.getElementById('card1');
  c0.style.top = row1Top + 'px'; c1.style.top = row1Top + 'px';
  var row1H = Math.max(c0.getBoundingClientRect().height, c1.getBoundingClientRect().height);

  var row2Top = row1Top + row1H + 24;
  var c2 = document.getElementById('card2'), c3 = document.getElementById('card3');
  c2.style.top = row2Top + 'px'; c3.style.top = row2Top + 'px';
  var row2H = Math.max(c2.getBoundingClientRect().height, c3.getBoundingClientRect().height);

  // Flow strips
  var flowTop = row2Top + row2H + 40;
  var flowA = document.getElementById('flowA');
  var flowB = document.getElementById('flowB');
  flowA.style.top = flowTop + 'px';
  var flowAH = flowA.getBoundingClientRect().height;
  flowB.style.top = (flowTop + flowAH + 16) + 'px';

  // Callout
  var callout = document.getElementById('callout');
  var aTop = flowA.getBoundingClientRect().top - cr.top;
  var bBottom = flowB.getBoundingClientRect().bottom - cr.top;
  callout.style.top = aTop + 'px';
  callout.style.height = Math.max(120, bBottom - aTop) + 'px';

  // Footer
  var footer = document.getElementById('footer');
  var calloutBottom = callout.getBoundingClientRect().bottom - cr.top;
  var lowest = Math.max(calloutBottom, bBottom);
  footer.style.top = (lowest + 40) + 'px';
};

document.fonts.ready.then(function() { window.drawInfographic(); });
</script>
</body>
</html>
